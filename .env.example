# Optional: Noevra starts without .env. Connect a provider in Settings instead.
# To use server credentials, copy this file to .env and fill only what you need.
DEFAULT_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional web search. Public academic APIs do not require these credentials.
TAVILY_API_KEY=

# Local defaults: persistent SQLite, no external database required.
APP_ENV=development
LOG_LEVEL=INFO
NOEVRA_DATA_DIR=./data
# Leave DATABASE_URL empty to use NOEVRA_DATA_DIR/research_assistant.db.
DATABASE_URL=
APP_PUBLIC_URL=http://127.0.0.1:8000
MAX_CONCURRENT_JOBS=3
MAX_QUEUED_JOBS=12
RESEARCH_TIMEOUT_SECONDS=900
REVISION_MAX=2

# Optional private-workspace password. Production requires both secrets + HTTPS.
WORKSPACE_PASSWORD=
SESSION_SECRET=
ALLOWED_ORIGINS=[]
CUSTOM_LLM_ALLOWED_ORIGINS=[]

# Optional Google OAuth: registered web client and enabled quota project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=

# Optional tracing exports research content; leave disabled by default.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=noevra
