# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Search API
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Tracing (Required for observability — get key at https://smith.langchain.com)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=research-assistant

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Job Processing
MAX_CONCURRENT_JOBS=3
REVISION_MAX=2

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/research_assistant.db

# Deployment: production requires HTTPS and both secrets below.
APP_PUBLIC_URL=http://127.0.0.1:8000
WORKSPACE_PASSWORD=
SESSION_SECRET=
ALLOWED_ORIGINS=[]
CUSTOM_LLM_ALLOWED_ORIGINS=[]
RESEARCH_TIMEOUT_SECONDS=900
MAX_QUEUED_JOBS=12

# Optional Google OAuth: registered web client, enabled API, quota project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT=

# Additional provider API keys (never put these in frontend files).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
